# ===== 密钥（绝不进版本库）=====
# 项目约定：密钥放在根目录，文件名任意但内容形如 sk-xxxx
apikey.txt
*.text
*.key
.env
.env.*

# ===== 依赖 =====
node_modules/
# package-lock.json 必须提交：锁定依赖版本，保证换机器能复现同样的出图结果

# ===== 生成产物（体积大、可重跑）=====
out/

# 每镜首帧、视频片段、成片都是可重跑的产物，不进版本库
projects/*/20-frames/
projects/*/30-video/
projects/*/40-out/
projects/*/h3_prompts.md
projects/*/manifest.json
projects/*/state.json

# ===== 临时与调试 =====
__pycache__/
*.pyc
*.log
*.tmp
.cache/
# 试验产物、对比图、临时截图，都不进版本库
projects/*/10-refs/_scratch/
projects/*/10-refs/_*.png
tools/storyboard/_*.js
